# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf
assets/polyhaven/**/*.jpg filter=lfs diff=lfs merge=lfs -text
assets/polyhaven/**/*.png filter=lfs diff=lfs merge=lfs -text
assets/polyhaven/**/*.hdr filter=lfs diff=lfs merge=lfs -text
assets/polyhaven/**/*.bin filter=lfs diff=lfs merge=lfs -text
